# ─────────────────────────────────────────────────────────────
# STAR PRODUCTION — environment variables
# Copy this file to `.env` (same folder) and fill in the values.
# `.env` is git-ignored and read ONLY by the server — nothing here reaches the browser.
# ─────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────
# SQLite file (path is relative to server/prisma/). START.bat overrides this with a
# local folder outside Google Drive so the database is safe and persistent.
# For PostgreSQL later: postgresql://user:pass@host:5432/dbname  (see README)
DATABASE_URL=file:./star.db

# ── Sessions ─────────────────────────────────────────────────
# Long random string (32+ chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# ── Payments ─────────────────────────────────────────────────
# Clients pay by UPI QR (Photos/Payment/UPI-QR.jpg) and send a screenshot; the admin confirms it in the admin panel.
# No payment-gateway keys are needed. To change the QR, replace that image file.

# ── Email ────────────────────────────────────────────────────
# EMAIL_API_KEY is the SMTP password. For Gmail: a Google "App Password".
# Leave SMTP_HOST empty to print emails to the server console instead of sending them.
# Hosts that block SMTP ports (many free tiers)? Use the HTTPS API instead: create a free Brevo account, verify the sender
# address (the one in EMAIL_FROM), and set BREVO_API_KEY — see DEPLOY.md. Admin panel → Emails shows every send and its result.
BREVO_API_KEY=
# true (default): a new client must click the link in the verification email before they can log in.
# (Automatically off while no email provider is configured, so nobody gets locked out.)
REQUIRE_EMAIL_VERIFICATION=true
EMAIL_API_KEY=
EMAIL_FROM="STAR PRODUCTION <starprod.in@gmail.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=starprod.in@gmail.com
# Receives "new paid order" notifications
ADMIN_NOTIFY_EMAIL=starprod.in@gmail.com

# ── First admin account (created by the seed: npm run db:seed / START.bat) ──
# Log in with these on the website to open the admin panel. (Empty password = a strong one is generated and printed once.)
# MAIN admin: sees every client detail, projects, messages — but can NOT confirm payments.
MAIN_ADMIN_NAME=Main Admin
MAIN_ADMIN_EMAIL=
MAIN_ADMIN_PASSWORD=
# SIDE admin (payments): sees payment details and CONFIRMS payments, plus messages and the overview numbers.
SIDE_ADMIN_NAME=Payments Admin
SIDE_ADMIN_EMAIL=
SIDE_ADMIN_PASSWORD=
# (10+ characters in production. Any other staff account is removed on every start.)

# ── Going public? See DEPLOY.md ─────────────────────────────
# On the host set (as environment variables, NOT in a committed file):
#   NODE_ENV=production   APP_URL=https://your-domain   TRUST_PROXY=1
#   MAIN_ADMIN_* and SIDE_ADMIN_* (passwords of 10+ characters — the server refuses shorter ones in production)

# ── Server ───────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public URL of the website. Production: https://your-domain.com
APP_URL=http://localhost:4000
# Extra browser origins allowed to call the API (Live Server :5500 is allowed automatically in development)
CORS_ORIGINS=
# 1 when running behind a reverse proxy (Render, Railway, Nginx…)
TRUST_PROXY=0
